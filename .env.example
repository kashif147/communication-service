# communication-service — example of variables introduced by Phase 2B Stream 3C.
# (Other settings live in the untracked .env.<env> files / config/.env.common.)

# Comma-separated SNS TopicArn allowlist for POST /api/webhooks/ses-sns.
# Messages (incl. SubscriptionConfirmation) from any other topic, or with an
# invalid/missing SNS signature, are rejected with 403. Empty = reject all.
SES_SNS_ALLOWED_TOPIC_ARNS=arn:aws:sns:eu-west-1:000000000000:ses-events-example

# App-only Microsoft Graph for document storage (OneDrive templates): the dedicated, single-tenant
# document-storage application (Graph application permission Files.ReadWrite.All) - never the
# shared CRM sign-in application. No fallback to the old GRAPH_CLIENT_ID / GRAPH_TENANT_ID /
# GRAPH_CLIENT_SECRET. Keep the secret in this service's own env file only, never in a shared
# env file loaded by other services.
GRAPH_DOCUMENT_CLIENT_ID=
GRAPH_DOCUMENT_TENANT_ID=
GRAPH_DOCUMENT_CLIENT_SECRET=
